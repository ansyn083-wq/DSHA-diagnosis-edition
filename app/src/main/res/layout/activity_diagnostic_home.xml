<?xml version="1.0" encoding="utf-8"?>
<com.deepseekharness.app.ui.ChatHomeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_chat_home" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="@color/gpt_bg">

    <LinearLayout android:id="@+id/native_chat_content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:focusableInTouchMode="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
            android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
            <Button android:id="@+id/native_chat_features" style="@style/Widget.GPT.Button.Text"
                android:layout_width="88dp" android:layout_height="48dp"
                android:gravity="start|center_vertical" android:paddingStart="12dp"
                android:text="@string/native_chat_brand" android:textSize="19sp" android:textStyle="bold"
                android:contentDescription="@string/native_chat_sidebar_open" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <TextView android:id="@+id/native_chat_title" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
                android:ellipsize="end" android:text="@string/native_chat_chat_title" android:textSize="18sp"
                android:textStyle="bold" android:textColor="@color/gpt_text" />
            <ImageButton android:id="@+id/native_chat_new_top"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_chat_new" android:contentDescription="@string/native_chat_new_chat" />
            <ImageButton android:id="@+id/diagnostic_settings"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ui_more" app:tint="@color/gpt_text"
                android:contentDescription="@string/native_chat_settings" />
        </LinearLayout>

        <ScrollView android:id="@+id/native_chat_scroll" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true" android:clipToPadding="false">
            <com.deepseekharness.app.ui.DiagnosticContentFrame android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="28dp" android:paddingBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal">

                    <TextView android:id="@+id/native_chat_welcome" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/native_chat_welcome" android:textSize="27sp"
                        android:textStyle="bold" android:gravity="center" android:textColor="@color/gpt_text" />
                    <LinearLayout android:id="@+id/native_chat_setup_card" android:visibility="gone"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:background="@drawable/gpt_surface_raised"
                        android:gravity="center_horizontal" android:orientation="vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp"
                        android:paddingBottom="8dp">
                        <TextView android:id="@+id/diagnostic_status" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="6dp"
                            android:text="@string/native_chat_preparing_chat" android:textSize="16sp" android:textStyle="bold"
                            android:gravity="center" android:textColor="@color/gpt_text"
                            android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/diagnostic_recovery_help" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:maxWidth="320dp" android:textSize="14sp" android:gravity="center"
                            android:textColor="@color/gpt_muted" android:visibility="gone" />
                        <Button android:id="@+id/diagnostic_primary" style="@style/Widget.GPT.Button.Primary"
                            android:layout_width="wrap_content" android:layout_height="48dp"
                            android:minWidth="132dp" android:layout_marginTop="12dp" android:text="@string/native_chat_preparing" />
                        <Button android:id="@+id/diagnostic_recover_service" style="@style/Widget.GPT.Button.Secondary"
                            android:layout_width="wrap_content" android:layout_height="48dp"
                            android:layout_marginTop="8dp" android:text="@string/native_chat_restart_service" android:visibility="gone" />
                        <LinearLayout android:id="@+id/native_chat_setup_links"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="4dp">
                            <Button android:id="@+id/diagnostic_export" style="@style/Widget.GPT.Button.Text"
                                android:layout_width="wrap_content" android:layout_height="48dp"
                                android:text="@string/native_chat_export_diagnostics" />
                            <Button android:id="@+id/diagnostic_details" style="@style/Widget.GPT.Button.Text"
                                android:layout_width="wrap_content" android:layout_height="48dp"
                                android:text="@string/native_chat_show_details" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/native_chat_messages" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:id="@+id/native_chat_turn_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp"
                        android:paddingBottom="6dp" android:textSize="13sp"
                        android:textColor="@color/gpt_muted" android:visibility="gone" />
                    <TextView android:id="@+id/native_chat_partial" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/gpt_text"
                        android:padding="12dp" android:textSize="16sp" android:visibility="gone" />
                </LinearLayout>
            </com.deepseekharness.app.ui.DiagnosticContentFrame>
        </ScrollView>
        <com.deepseekharness.app.ui.DiagnosticContentFrame android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingBottom="12dp">
                    <Button android:id="@+id/native_chat_question" style="@style/Widget.GPT.Button.Secondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:visibility="gone" />
                    <TextView android:id="@+id/native_chat_status" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textColor="@color/gpt_muted" android:accessibilityLiveRegion="polite" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/gpt_chat_composer"
                        android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="4dp">
                        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/diagnostic_draft"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:minHeight="48dp" android:maxLines="4" android:inputType="textMultiLine"
                            android:background="@null" android:hint="@string/native_chat_message_hint"
                            android:paddingStart="18dp" android:paddingEnd="8dp"
                            android:paddingTop="12dp" android:paddingBottom="12dp"
                            android:textColor="@color/gpt_text" android:textColorHint="@color/gpt_muted"
                            android:textSize="16sp" android:gravity="center_vertical" />
                        <HorizontalScrollView android:id="@+id/native_chat_attachment_strip"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:scrollbars="none" android:visibility="gone">
                            <LinearLayout android:id="@+id/native_chat_attachments"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageButton android:id="@+id/native_chat_add"
                                android:layout_width="48dp" android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_native_chat_add" android:contentDescription="@string/native_chat_add_attachment" />
                            <Space android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="1dp" />
                            <LinearLayout android:layout_width="172dp" android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp" android:orientation="vertical">
                                <Button android:id="@+id/native_chat_model" style="@style/Widget.GPT.Button.Text"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:minHeight="38dp" android:gravity="end|center_vertical"
                                    android:paddingStart="8dp" android:paddingEnd="6dp"
                                    android:singleLine="true" android:ellipsize="end"
                                    android:text="@string/native_chat_choose_model" />
                                <LinearLayout android:id="@+id/native_chat_effort" android:visibility="gone"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:orientation="horizontal" android:gravity="center_vertical">
                                    <com.google.android.material.slider.Slider
                                        android:id="@+id/native_chat_effort_slider"
                                        android:layout_width="0dp" android:layout_weight="1"
                                        android:layout_height="48dp" android:saveEnabled="false" />
                                    <TextView android:id="@+id/native_chat_effort_value"
                                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:maxWidth="60dp" android:singleLine="true" android:ellipsize="end"
                                        android:textSize="12sp" android:textColor="@color/gpt_muted"
                                        android:paddingEnd="6dp" />
                                </LinearLayout>
                            </LinearLayout>
                            <ImageButton android:id="@+id/native_chat_send"
                                android:layout_width="48dp" android:layout_height="48dp"
                                android:background="@drawable/gpt_chat_send"
                                android:src="@drawable/ic_chat_send" android:contentDescription="@string/native_chat_send"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
            </LinearLayout>
        </com.deepseekharness.app.ui.DiagnosticContentFrame>
    </LinearLayout>
    <View android:id="@+id/native_chat_scrim" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="#66000000"
        android:visibility="gone" android:importantForAccessibility="no" />
    <include layout="@layout/view_native_chat_sidebar" />
</com.deepseekharness.app.ui.ChatHomeLayout>
